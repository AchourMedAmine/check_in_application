generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Participant {
  id        String   @id @default(cuid())
  qrCode    String   @unique
  name      String?
  email     String?
  scannedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("participants")
}
