// Prisma 7: the datasource URL lives in prisma.config.ts, not here.
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // The website owns `public`; this app owns `checkin` and nothing else.
  schemas  = ["public", "checkin"]

  // No physical foreign keys between the two schemas: Prisma resolves
  // relations in the app layer instead. That keeps the website's migrations
  // on `public` completely independent of our tables.
  relationMode = "prisma"
}

// ─────────────────────────────────────────────────────────────────────────────
// Read-only mirror of the TRSYP website's `participants` table.
// Scalar fields copied 1:1 from the website's Participant model; relations
// (User, Room, Invitation, Team…) are intentionally omitted — this app only
// looks participants up. Enum names/labels MUST match the Postgres types.
// Never run `prisma migrate` / `db push` from this repo.
// ─────────────────────────────────────────────────────────────────────────────

enum ParticipantType {
  NonIEEE
  Student
  YoungProfessional

  @@schema("public")
}

