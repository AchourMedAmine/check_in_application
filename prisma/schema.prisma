model Participant {
  id              String          @id @default(uuid())
  userId          String          @unique @map("user_id")
  ieeeId          Int?            @unique @map("ieee_id")
  phone           String          @unique
  gender          String
  paid            Boolean         @default(false)
  isInternational Boolean         @default(false) @map("is_international")
  isRas           Boolean         @default(false) @map("is_ras")
  banned          Boolean         @default(false)
  participantType ParticipantType @map("participant_type")
  sb              SB?
  country         COUNTRY
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  roomId          String?

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  presences Presence[]
  sessions  SessionParticipant[]
  penalties Penalty[]

  @@index([userId])
  @@map("participants")
  @@schema("public")
}

// Minimal mirror of the website's `users` table — only the identity columns
// the scanner displays. (Other columns exist; they are simply not mapped.)
model User {
  id        String   @id
  email     String   @unique
  name      String
  lastName  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participant Participant?

  @@map("users")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// Attendance — tables owned by THIS app, in the `checkin` Postgres schema.
// Created by prisma/sql/001_checkin_schema.sql (applied manually, since this
// repo must never run `prisma migrate` against the website's database).
// ─────────────────────────────────────────────────────────────────────────────

enum SessionStatus {
  Scheduled
  Open
  Closed

  @@schema("checkin")
}

/// Who is expected at a session.
enum Audience {
  /// Every participant, e.g. the Opening Ceremony.
  Everyone
  /// Only the participants listed in SessionParticipant, e.g. a workshop.
  Assigned

  @@schema("checkin")
}

model Session {
  id       String  @id @default(uuid())
  title    String
  location String?

  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")

  /// Who is expected: everyone, or only the assigned roster.
  audience Audience @default(Everyone)

  /// Absence / over-long breaks cost the participant's SB points.
  mandatory Boolean @default(true)

  /// Minutes a participant may be out before their SB loses points.
  breakAllowanceMinutes Int @default(15) @map("break_allowance_minutes")
  penaltyPoints         Int @default(5) @map("penalty_points")

  /// A technical-challenge slot: its roster is excused from every session
  /// that overlaps it.
  challenge Boolean @default(false)

  /// When the doors opened and scanning began (automatically 30 minutes
  /// before startsAt, or earlier by a manager).
  openedAt DateTime? @map("opened_at")

  /// When the session really began — tapped at the door when the moderator
  /// or instructor started. Lateness counts from here; null = nobody late.
  startedAt DateTime? @map("started_at")

  status    SessionStatus @default(Scheduled)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  presences Presence[]
  expected  SessionParticipant[]
  penalties Penalty[]

  @@index([status, startsAt])
  @@map("sessions")
  @@schema("checkin")
}

/// Why points were taken off a student branch.
enum PenaltyReason {
  /// A break longer than the session allowance.
  OverBreak
  /// Left and never came back — charged when the session was closed.
  LeftEarly
  /// Expected and never scanned — charged when the session was closed.
  Absent
  /// First scan more than the grace period after the start.
  Late

  @@schema("checkin")
}

/// One over-long break, charged to the participant's student branch.
/// Append-only: the leaderboard is SUM(points) GROUP BY sb.
model Penalty {
  id String @id @default(uuid())

  participantId String @map("participant_id")
  sessionId     String @map("session_id")

  /// The interval this penalty hangs off: the one left from (OverBreak,
  /// LeftEarly) or the first check-in (Late). Null for Absent.
  presenceId String? @map("presence_id")

  /// Snapshots taken when the penalty was charged — never re-derived, so
  /// later edits to a participant's SB or a session's points cannot rewrite
  /// history.
  sb           SB?
  /// Minutes out (OverBreak, LeftEarly) or minutes late (Late); 0 for Absent.
  breakMinutes Int @map("break_minutes")
  points       Int

  reason    PenaltyReason @default(OverBreak)
  createdAt DateTime      @default(now()) @map("created_at")

  participant Participant @relation(fields: [participantId], references: [id])
  session     Session     @relation(fields: [sessionId], references: [id])
  presence    Presence?   @relation(fields: [presenceId], references: [id])

  /// A retry, a double scan, or a re-run of closeSession can never charge
  /// the same break twice.
  @@unique([presenceId, reason])
  @@index([sb])
  @@index([sessionId])
  @@index([participantId])
  @@map("penalties")
  @@schema("checkin")
}

/// The roster of an `Assigned` session. Populated from the participants'
/// workshop choices on the TRSYP website; empty for `Everyone` sessions.
model SessionParticipant {
  sessionId     String   @map("session_id")
  participantId String   @map("participant_id")
  addedAt       DateTime @default(now()) @map("added_at")

  session     Session     @relation(fields: [sessionId], references: [id])
  participant Participant @relation(fields: [participantId], references: [id])

  @@id([sessionId, participantId])
  @@index([participantId])
  @@map("session_participants")
  @@schema("checkin")
}

/// One IN→OUT interval. A participant can have several per session (they may
/// step out and come back); a partial unique index in SQL guarantees at most
/// one OPEN interval (check_out_at IS NULL) per participant per session.
model Presence {
  id String @id @default(uuid())

  participantId String @map("participant_id")
  sessionId     String @map("session_id")

  checkInAt  DateTime  @default(now()) @map("check_in_at")
  checkOutAt DateTime? @map("check_out_at")

  /// Free-text staff/station label, e.g. "door-A".
  stationId String? @map("station_id")

  /// The scanner accounts that recorded the check-in and the check-out.
  checkInScannerId  String? @map("check_in_scanner_id")
  checkOutScannerId String? @map("check_out_scanner_id")

  participant Participant @relation(fields: [participantId], references: [id])
  session     Session     @relation(fields: [sessionId], references: [id])
  penalties   Penalty[]

  @@index([sessionId, checkOutAt])
  @@index([participantId, sessionId, checkInAt])
  @@map("presences")
  @@schema("checkin")
}

/// What a scanner account may do.
enum ScannerRole {
  /// Scans badges and reads the roster.
  Scanner
  /// Also opens and closes sessions — closing is what charges LeftEarly.
  Manager

  @@schema("checkin")
}

/// A person allowed to use the app. Created by prisma/sql/004_scanners.sql;
/// accounts are managed with `npm run scanners`.
model Scanner {
  id           String      @id @default(uuid())
  /// Always lower-case.
  username     String      @unique(map: "scanners_username_key")
  displayName  String      @map("display_name")
  passwordHash String      @map("password_hash")
  role         ScannerRole @default(Scanner)
  active       Boolean     @default(true)

  /// Part of the signed cookie; bumping it signs out every device.
  sessionVersion Int       @default(0) @map("session_version")

  failedLogins Int       @default(0) @map("failed_logins")
  lockedUntil  DateTime? @map("locked_until")
  lastLoginAt  DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("scanners")
  @@schema("checkin")
}
